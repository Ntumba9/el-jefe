# Two separate credentials, two separate trust levels: whatever can submit
# events (e.g. an Activepieces flow) should not also be able to approve a
# containment decision for a human.
ELJEFE_INGEST_API_KEY=change-me-ingest
ELJEFE_DECISION_API_KEY=change-me-decision

# SQLite database file (created automatically on first run)
ELJEFE_DB_PATH=./eljefe.db

# https://www.abuseipdb.com/account/api (free tier)
ABUSEIPDB_API_KEY=

# https://www.virustotal.com/gui/my-apikey (free tier)
VIRUSTOTAL_API_KEY=

# Correlation window, in minutes, used by the detection engine
ELJEFE_CORRELATION_WINDOW_MINUTES=15

# Detection thresholds
ELJEFE_FAILED_LOGIN_THRESHOLD=5
ELJEFE_SPRAY_DISTINCT_ACCOUNTS_THRESHOLD=4
ELJEFE_ABUSEIPDB_SCORE_THRESHOLD=50

# How long a cached threat-intel lookup stays valid, in minutes
ELJEFE_INTEL_CACHE_TTL_MINUTES=60

# How many days back to look when counting a username/IP's prior HIGH or
# CRITICAL incidents for the cross-incident correlation context
ELJEFE_INCIDENT_CORRELATION_LOOKBACK_DAYS=30

# Retry behavior for AbuseIPDB/VirusTotal calls (connection errors and
# 429/5xx responses only)
ELJEFE_INTEL_MAX_RETRIES=2
ELJEFE_INTEL_RETRY_BACKOFF_SECONDS=0.5

# Python logging level for the structured JSON logs written to stdout
ELJEFE_LOG_LEVEL=INFO
